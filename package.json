{
  "name": "opensinnoh",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "An open-source reimplementation of the Nintendo DS Pokémon games, playable in the browser. Bring your own ROM.",
  "homepage": "https://opensinnoh.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DennisSnijder/open-sinnoh.git"
  },
  "bugs": "https://github.com/DennisSnijder/open-sinnoh/issues",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "merge:main": "node tools/merge-main.ts",
    "dev": "tsx packages/cli/src/index.ts dev packs/fixture packs/demo-mod",
    "build": "vite build",
    "site:dev": "pnpm --filter @opensinnoh/site dev",
    "site:build": "pnpm --filter @opensinnoh/site build",
    "site:preview": "pnpm --filter @opensinnoh/site preview",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .opensinnoh-cache/tsc.tsbuildinfo",
    "lint": "eslint . --max-warnings 0 --cache --cache-strategy content --cache-location .opensinnoh-cache/eslint/",
    "test": "vitest run",
    "test:changed": "vitest run --changed main",
    "test:replays": "pnpm -s opensinnoh test packs/fixture > /dev/null && pnpm -s opensinnoh test packs/demo-mod > /dev/null",
    "test:browser": "playwright test",
    "test:browser:shard": "playwright test",
    "test:browser:changed": "node tools/browser-changed.ts",
    "test:browser:merge": "playwright merge-reports --config playwright.merge.config.ts",
    "sweep:browser": "tsx tools/sweep-browser.ts",
    "check": "node tools/check.ts",
    "opensinnoh": "tsx packages/cli/src/index.ts",
    "fixtures": "tsx tools/fixtures/build-fixture-pack.ts",
    "names": "tsx tools/names/generate.ts",
    "brand:assets": "tsx tools/brand-assets.ts",
    "import-local": "tsx tools/import-local.ts",
    "ui2d-dump": "tsx tools/ui2d-dump.ts",
    "viewer": "vite --config tools/model-viewer/vite.config.ts",
    "viewer:check": "tsx tools/model-viewer/check.ts",
    "import-assets": "tsx tools/model-viewer/import-assets.ts",
    "preview": "vite preview",
    "perf": "tsx tools/perf.ts",
    "flaky": "tsx tools/flaky.ts",
    "clean:worktrees": "tsx tools/clean-worktrees.ts",
    "relocate": "tsx tools/relocate.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opensinnoh/audio": "workspace:*",
    "@opensinnoh/battle": "workspace:*",
    "@opensinnoh/cli": "workspace:*",
    "@opensinnoh/contracts": "workspace:*",
    "@opensinnoh/core": "workspace:*",
    "@opensinnoh/g3d": "workspace:*",
    "@opensinnoh/game": "workspace:*",
    "@opensinnoh/importer": "workspace:*",
    "@opensinnoh/menus": "workspace:*",
    "@opensinnoh/nds": "workspace:*",
    "@opensinnoh/services": "workspace:*",
    "@opensinnoh/ui": "workspace:*",
    "@opensinnoh/vm": "workspace:*",
    "@opensinnoh/world": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "5.4.0",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "fake-indexeddb": "6.0.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
