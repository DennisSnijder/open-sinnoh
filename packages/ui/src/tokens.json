{
  "name": "OpenSinnoh UI",
  "version": "0.7",
  "unit": {
    "dot": 2,
    "grid": 4,
    "touchTarget": 44,
    "phoneBreakpoint": 480
  },
  "space": [4, 8, 12, 16, 24, 32, 48, 64],
  "spaceExceptions": {
    "2": "one dot (rims, hairlines, the focus ring, shadows)",
    "10": "the Distortion window border (5 dots)",
    "44": "minimum touch target"
  },
  "type": {
    "pixel": {
      "family": "Pixelify Sans",
      "weight": 500,
      "size": 20,
      "line": 24,
      "title": 32,
      "use": "OpenSinnoh screens: titles, tabs, row labels, values, buttons. Shadow 1 dot right, down, diagonal on window faces. Ligatures off (Pixelify's fi reads as an A)."
    },
    "num": {
      "family": "Silkscreen",
      "size": 16,
      "line": 20,
      "use": "Numbers, counts, steps, caps labels and badges (crisp: an 8-px-per-em grid drawn at 2x)"
    },
    "body": {
      "family": "Figtree",
      "size": 14,
      "line": 20,
      "use": "Descriptions, help, dialogs, the website"
    },
    "lead": {
      "family": "Figtree",
      "size": 16,
      "line": 24,
      "use": "Longer reading text, the landing pitch"
    },
    "small": {
      "family": "Figtree",
      "size": 12,
      "line": 16,
      "use": "Captions, legal, meta"
    },
    "mono": {
      "family": "JetBrains Mono",
      "size": 12,
      "line": 16,
      "use": "Crash details, hashes"
    },
    "display": {
      "family": "Pixelify Sans",
      "weight": 700,
      "sizes": [40, 64],
      "use": "Wordmark and landing headline"
    },
    "gameVoice": {
      "family": "ROM font (runtime)",
      "use": "Anything the game draws. Never a web font."
    }
  },
  "motion": {
    "frame": 33.333,
    "cursor": {
      "frames": 0
    },
    "press": {
      "frames": 1,
      "timing": "steps(1)"
    },
    "windowIn": {
      "frames": 4,
      "timing": "steps(4)"
    },
    "windowOut": {
      "frames": 2,
      "timing": "steps(2)"
    },
    "toastIn": {
      "frames": 6,
      "timing": "steps(6)"
    },
    "toastHold": {
      "frames": 80
    },
    "typing": {
      "slow": 3,
      "mid": 2,
      "fast": 1,
      "unit": "frames per character, from Text speed; instant with reduced motion"
    },
    "nextBob": {
      "frames": 16,
      "timing": "steps(2)"
    }
  },
  "color": {
    "bg": { "group": "base", "dark": "#0b0d12", "light": "#e6e4dd", "role": "Page, website, wells" },
    "field": { "group": "base", "dark": "#10131a", "light": "#dcd9d0", "role": "Field behind our windows when no game is drawn" },
    "dot": { "group": "base", "dark": "#1d222d", "light": "#c8c4b8", "role": "The dot grid on the field (decorative)" },
    "ink": { "group": "base", "dark": "#edece6", "light": "#22252b", "role": "Text" },
    "muted": { "group": "base", "dark": "#a7aebb", "light": "#575c63", "role": "Secondary text" },
    "ink-off": { "group": "base", "dark": "#6f7787", "light": "#8d9196", "role": "Disabled text" },
    "line": { "group": "base", "dark": "#262c38", "light": "#cfcbc0", "role": "Dividers (decorative)" },
    "face": { "group": "window", "dark": "#1d222c", "light": "#f6f4ee", "role": "Window face" },
    "face-alt": { "group": "window", "dark": "#222833", "light": "#eeebe3", "role": "Alternate row tint (long lists only)" },
    "ring": { "group": "window", "dark": "#2b5f59", "light": "#2e6b64", "role": "Distortion frame: the 2-dot teal ring" },
    "rim": { "group": "window", "dark": "#07090d", "light": "#0b0d12", "role": "Distortion frame: the 1-dot near-black rim" },
    "halo": { "group": "window", "dark": "#465062", "light": "#ffffff", "role": "Distortion frame: 1-dot outer halo, so the dark rim reads on any field" },
    "inner": { "group": "window", "dark": "#2c3340", "light": "#d5d3cb", "role": "Distortion frame: 1-dot inner line" },
    "edge": { "group": "window", "dark": "#6b7588", "light": "#0b0d12", "role": "Control and tab rim (3:1 on the face)" },
    "ink-shadow": { "group": "window", "dark": "#07090d", "light": "#d7d4cb", "role": "Pixel text shadow on window faces" },
    "shadow": { "group": "window", "dark": "rgba(0,0,0,.55)", "light": "rgba(11,13,18,.3)", "role": "Drop frame shadow" },
    "sel": { "group": "window", "dark": "#303b56", "light": "#f3e6c6", "role": "Cursor row fill" },
    "sel-line": { "group": "window", "dark": "#5f74aa", "light": "#b8913f", "role": "Cursor row 1-dot line (decorative; the ▶ is the cue)" },
    "accent": { "group": "window", "dark": "#f4a93c", "light": "#7a4c00", "role": "Gold: the ▶ cursor, the chosen value, focus, the active tab" },
    "action": { "group": "window", "dark": "#2e6b64", "light": "#245a54", "role": "Primary button fill (teal)" },
    "on-action": { "group": "window", "dark": "#ffffff", "light": "#ffffff", "role": "Text on the primary button" },
    "danger": { "group": "state", "dark": "#ff8277", "light": "#b3302a", "role": "Destructive actions and errors only" },
    "on-danger": { "group": "state", "dark": "#1a0806", "light": "#ffffff", "role": "Text on danger" },
    "ok": { "group": "state", "dark": "#62d18d", "light": "#1d7442", "role": "Done, valid" },
    "tone-world": { "group": "tone", "dark": "#52c7bd", "light": "#0f6a64", "role": "Where you are and what is next" },
    "tone-team": { "group": "tone", "dark": "#ff9f6e", "light": "#a84c18", "role": "Your party and its members" },
    "tone-items": { "group": "tone", "dark": "#d9b65c", "light": "#7d5c08", "role": "What you carry" },
    "tone-system": { "group": "tone", "dark": "#b49cff", "light": "#6243b8", "role": "OpenSinnoh itself: options, setup, data, your game file" },
    "tone-danger": { "group": "tone", "dark": "#ff8277", "light": "#b3302a", "role": "Crash and destructive dialogs" },
    "on-tone": { "group": "tone", "dark": "#10131a", "light": "#ffffff", "role": "Text on a title tab" },
    "mark-tab-shade": { "group": "brand", "dark": "#b8761c", "light": "#b8761c", "role": "The mark's gold title tab: its inner line (fixed art, the same in both themes)" },
    "mark-strip": { "group": "brand", "dark": "#4f9b91", "light": "#4f9b91", "role": "The 16-px mark's title strip highlight (fixed art)" },
    "on-accent": { "group": "window", "dark": "#10131a", "light": "#ffffff", "role": "Text and marks on the accent (badges, the toggle's knob)" },
    "scrim": { "group": "window", "dark": "rgba(6,8,12,.40)", "light": "rgba(30,40,60,.20)", "role": "Dims what is behind a dialog" },
    "hp-high": { "group": "hp", "dark": "#4cc96b", "light": "#23863f", "role": "HP above half" },
    "hp-mid": { "group": "hp", "dark": "#f2d03a", "light": "#8a6a00", "role": "HP above a fifth" },
    "hp-low": { "group": "hp", "dark": "#ff6b5e", "light": "#c0392b", "role": "HP at a fifth or less" },
    "eff-weak": { "group": "eff", "dark": "#ff7aa8", "light": "#b0245e", "role": "Takes more damage (x2, x4)" },
    "eff-resist": { "group": "eff", "dark": "#9ab4d6", "light": "#4a6488", "role": "Takes less damage (x1/2, x1/4)" },
    "eff-immune": { "group": "eff", "dark": "#8a93a3", "light": "#646d7d", "role": "Takes no damage (x0)" },
    "type-normal": { "group": "type", "dark": "#b5b39c", "light": "#6f6c55", "role": "Normal" },
    "type-fire": { "group": "type", "dark": "#f08a48", "light": "#b4501c", "role": "Fire" },
    "type-water": { "group": "type", "dark": "#6f9ef2", "light": "#2d62c4", "role": "Water" },
    "type-grass": { "group": "type", "dark": "#74c653", "light": "#3b7f22", "role": "Grass" },
    "type-electric": { "group": "type", "dark": "#f2d04a", "light": "#876a00", "role": "Electric" },
    "type-psychic": { "group": "type", "dark": "#f27598", "light": "#b8326a", "role": "Psychic" },
    "on-type": { "group": "type", "dark": "#10131a", "light": "#ffffff", "role": "Icon on a type square" },
    "status-psn": { "group": "status", "dark": "#b98ae0", "light": "#7b3fb0", "role": "Poisoned" },
    "status-brn": { "group": "status", "dark": "#f0904f", "light": "#a8481a", "role": "Burned" },
    "status-par": { "group": "status", "dark": "#e8c53a", "light": "#7d6400", "role": "Paralysed" },
    "status-slp": { "group": "status", "dark": "#a3aec0", "light": "#5a6476", "role": "Asleep" },
    "status-frz": { "group": "status", "dark": "#84d4e8", "light": "#1d7088", "role": "Frozen" },
    "status-fnt": { "group": "status", "dark": "#9aa3b2", "light": "#6b7280", "role": "Fainted" },
    "on-status": { "group": "status", "dark": "#10131a", "light": "#ffffff", "role": "Text on a status chip" }
  },
  "frames": {
    "distortion": {
      "name": "Distortion",
      "slice": 5,
      "tl": [".hhhhh", "hrrrrr", "hrmmmm", "hrmmmm", "hrmmii", "hrmmif"],
      "rule": "Default. Halo, near-black rim, 2-dot teal ring, inner line, then the face. Corners cut by one dot."
    },
    "slim": {
      "name": "Slim",
      "slice": 2,
      "tl": [".hh", "hrr", "hrf"],
      "rule": "Quiet. Halo and rim only."
    },
    "drop": {
      "name": "Drop",
      "slice": 5,
      "tl": [".hhhhh", "hrrrrr", "hrmmmm", "hrmmmm", "hrmmii", "hrmmif"],
      "drop": 2,
      "rule": "Distortion with a hard 2-dot shadow down and right."
    },
    "control": {
      "name": "Control",
      "slice": 2,
      "tl": [".ee", "eff", "eff"],
      "shade": true,
      "rule": "Buttons and title tabs: a 1-dot edge and, on buttons, a 1-dot shade above the bottom edge. Fixed: never follows the Frame option."
    }
  }
}
