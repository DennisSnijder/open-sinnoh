# sys-giratina-fled: focused room coverage (story branch: m5-giratina-fled).
# The Giratina room's native script, the player runs. The same constructed start as
# sys-giratina-caught. get_battle_result 5 (PLAYER_FLED) takes DistortionWorldGiratinaRoom_PlayerRan ("You refused
# to battle"); the field's return removes Giratina all the same (progress 14), and Giratina is not caught.
party 0 platinum:SPECIES_GARCHOMP 100 platinum:MOVE_DRAGON_CLAW
set var platinum:VAR_DISTORTION_WORLD_PROGRESS 13
warp platinum:MAP_HEADER_DISTORTION_WORLD_GIRATINA_ROOM 15 14 up
until idle
+0 press a
+1 release a
advance text 3000
until battle 3000
+0 battle run
advance text 20000
until idle 3000
+0 assert battle scripted platinum:SPECIES_GIRATINA fled
+0 assert flag platinum:FLAG_CAUGHT_GIRATINA false
+0 assert flag platinum:FLAG_MAP_LOCAL_REMOVE_OBJECT false
+0 assert var platinum:VAR_DISTORTION_WORLD_PROGRESS 14
