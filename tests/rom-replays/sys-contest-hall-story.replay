# The Contest Hall's story with contests in the engine (decomp scripts_contest_hall_lobby.s): the first entry (Keira and
# Mom, the Glitter Powder, the tuxedo, FLAG_CONTEST_HALL_VISITED), then Fantina, who leaves for her gym
# (FLAG_HIDE_HEARTHOME_CITY_GYM_GUIDE). No contest is needed for either. Then a practice Visual Competition at the
# practice receptionist (the dress-up: R to the Glitter Powder's page of the Fashion Case, Y, A, Y to Staravia's head,
# A, X for DONE; the judging), its verdict and NO to another try.
party 0 platinum:SPECIES_STARAVIA 20 platinum:MOVE_WING_ATTACK platinum:MOVE_QUICK_ATTACK
set var platinum:VAR_HEARTHOME_CITY_STATE 1
warp platinum:MAP_HEADER_CONTEST_HALL_LOBBY 16 13 up
until message 3000
advance text 6000
until idle 3000
+0 assert flag platinum:FLAG_CONTEST_HALL_VISITED true
+0 assert var platinum:VAR_CONTEST_HALL_LOBBY_STATE 1
+0 assert state fashionCase.accessories[49] 1
+0 assert position platinum:MAP_HEADER_CONTEST_HALL_LOBBY 16 11
# Fantina in the lobby (ContestHallLobby_Fantina)
+0 press right
until position 21 11 6000
+0 release right
+0 press up
until position 21 9 6000
+0 release up
until idle
+0 press right
+1 release right
until idle
+0 press a
+1 release a
advance text 6000
until idle 3000
+0 assert flag platinum:FLAG_HIDE_HEARTHOME_CITY_GYM_GUIDE true
# The practice receptionist: PRACTICE, VISUAL, COOL, Staravia
+0 press right
until position 27 9 6000
+0 release right
+0 press up
until position 27 6 6000
+0 release up
until idle
+0 press a
+1 release a
advance text
until menu
+2 press a
+1 release a
+8 release a
until menu
+2 press a
+1 release a
advance text
until menu
+2 press a
+1 release a
advance text
until app party 600
+2 tap slot:0
+2 tap menu:0
until app none 600
advance text 6000
until app contest 6000
+0 assert state contest.mode "practice"
+0 assert state contest.competition 3
until state app.round.message.waiting true 120
+0 press a
+1 release a
until state app.round.message.waiting true 60
+0 press a
+1 release a
until state app.round.message.waiting true 60
+0 press a
+1 release a
until state app.round.message.waiting true 60
+0 press a
+1 release a
until state app.round.message.waiting true 60
+0 press a
+1 release a
until state app.round.message.waiting true 60
+0 press a
+1 release a
until state app.round.dress.seconds 59 60
+1 press r
+1 release r
+1 press y
+1 release y
+1 press a
+1 release a
+1 press y
+1 release y
+1 press a
+1 release a
+1 assert state app.round.dress.placed 1
+1 assert state app.round.dress.page 8
+1 press x
+1 release x
# The judging's MC: four messages, the first two back to back, then three more about 70 ticks apart (the app closes
# about as long after the last). A on every page, however many pages the build's language has: from the first page,
# A every five ticks, more presses than the message has pages (a spare lands in the pause after it, where A does
# nothing).
until state app.round.message.waiting true 300
+0 press a
+1 release a
+4 press a
+1 release a
+4 press a
+1 release a
+4 press a
+1 release a
+4 press a
+1 release a
+4 press a
+1 release a
+4 press a
+1 release a
+4 press a
+1 release a
until state app.round.message.waiting true 300
+0 press a
+1 release a
+4 press a
+1 release a
+4 press a
+1 release a
+4 press a
+1 release a
until state app.round.message.waiting true 300
+0 press a
+1 release a
+4 press a
+1 release a
+4 press a
+1 release a
+4 press a
+1 release a
until state app.round.message.waiting true 300
+0 press a
+1 release a
+4 press a
+1 release a
+4 press a
+1 release a
+4 press a
+1 release a
until app none 600
advance text 6000
until yesno 6000
+0 assert var platinum:VAR_0x8004 0
+2 press b
+1 release b
advance text 6000
until idle 6000
+0 assert state party[0].ribbons []
+0 reload
until idle
+0 assert flag platinum:FLAG_CONTEST_HALL_VISITED true
+0 assert state fashionCase.accessories[49] 1
