from cp15-giratina-room.replay
# Story branch m5-giratina-caught. The anchor plays CP15 from the HQ through
# Spear Pillar, the full Distortion World puzzle, Cyrus 404 and Giratina's arrival. No warp or
# progress/object setup. Use the Master Ball awarded by Cyrus in Galactic HQ (CP14).
+0 reload
until idle 6000
+0 assert var platinum:VAR_DISTORTION_WORLD_PROGRESS 13
+0 assert flag platinum:FLAG_DISTORTION_WORLD_PUZZLE_FINISHED true
+0 assert flag platinum:FLAG_CAUGHT_GIRATINA false
+0 assert state bag.balls[item="platinum:ITEM_MASTER_BALL"].count 1
+0 assert position platinum:MAP_HEADER_DISTORTION_WORLD_GIRATINA_ROOM 15 14
+0 assert state player.y 16
+0 press a
+1 release a
advance text 3000
battle catch platinum:ITEM_MASTER_BALL 20000
+0 assert battle scripted platinum:SPECIES_GIRATINA caught
advance text 20000
until idle 6000
+0 assert flag platinum:FLAG_CAUGHT_GIRATINA true
+0 assert flag platinum:FLAG_HIDE_TURNBACK_CAVE_GIRATINA_ROOM_GIRATINA true
+0 assert flag platinum:FLAG_HIDE_TURNBACK_CAVE_GIRATINA_ROOM_ITEM false
+0 assert party 5 platinum:SPECIES_GIRATINA
+0 assert state party[5].form 1
+0 assert flag platinum:FLAG_MAP_LOCAL_REMOVE_OBJECT false
+0 assert var platinum:VAR_DISTORTION_WORLD_PROGRESS 14
+0 assert state player {"zone":"platinum:MAP_HEADER_DISTORTION_WORLD_GIRATINA_ROOM","x":15,"z":14,"y":16,"facing":"down"}
+0 assert state mapFeatures.cameraAngle [0,0,0]
# CP15's portal and Cynthia's Sendoff Spring conversation, through ordinary story input.
+0 press up
+1 release up
until idle 600
# the portal: go through (yes), then the talk at Sendoff Spring
+0 press a
+1 release a
advance text
until yesno
+0 press a
+1 release a
advance text 6000
+6 assert state player.zone "platinum:MAP_HEADER_SENDOFF_SPRING"
+0 assert state player {"zone":"platinum:MAP_HEADER_SENDOFF_SPRING","x":32,"z":17,"y":32,"facing":"left"}
+0 assert var platinum:VAR_DISTORTION_WORLD_PROGRESS 14
until idle 6000
+0 assert var platinum:VAR_EXITED_DISTORTION_WORLD_STATE 2
+0 assert flag platinum:FLAG_DISTORTION_WORLD_PUZZLE_FINISHED true
+0 assert state party[5].form 0
+0 assert state mapFeatures null
+0 assert var platinum:VAR_SANDGEM_TOWN_LAB_STATE 2
+0 assert flag platinum:FLAG_SPEAR_PILLAR_IS_DISTORTED false
+0 assert flag platinum:FLAG_GALACTIC_LEFT_LAKE_VALOR true
