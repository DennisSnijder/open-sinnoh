# svc-card (the card part of svc-card-dex; the Pokédex is separate): the
# trainer card front (ID, money, badges, the Pokédex seen count, time, start date) and back, the card's
# colour by its stars (the game completed: one star, cobalt), and signing the back (decomp signature.c:
# pen strokes, DONE, "Is this OK?" YES saves it and scores TRAINER_SCORE_EVENT_SIGNED_TRAINER_CARD).
party 0 platinum:SPECIES_TURTWIG 12
party 1 platinum:SPECIES_STARLY 8
party 2 platinum:SPECIES_BIDOOF 6
set state pokedex.obtained true
set state pokedex.seen ["platinum:SPECIES_TURTWIG","platinum:SPECIES_STARLY","platinum:SPECIES_BIDOOF","platinum:SPECIES_KRICKETOT","platinum:SPECIES_SHINX"]
set state pokedex.caught ["platinum:SPECIES_TURTWIG","platinum:SPECIES_STARLY","platinum:SPECIES_BIDOOF"]
give badge platinum:BADGE_ID_COAL
set flag platinum:FLAG_GAME_COMPLETED true
set money 12345
warp platinum:MAP_HEADER_JUBILIFE_CITY_POKECENTER_1F 12 4 up
until idle
+1 press x
+1 release x
until app start-menu
# the trainer card (the player's entry): front, then the back (A flips it)
+1 tap entry:3
+1 assert app trainer-card
+0 assert state money 12345
+0 assert state records.score 0
+0 screenshot card-front
+1 press a
+1 release a
+0 screenshot card-back
# sign the back: two strokes (the first over two ticks), then DONE and YES
+1 tap sign
+1 tap pen:20,40;40,20;60,44
+1 tap pen:80,18;100,46
+1 tap pen-up
+1 tap pen:120,30;170,30
+1 tap pen-up
+0 screenshot card-signing
+1 tap done
+1 tap yes
+1 assert state records.score 1
+0 assert state signature ""
+0 screenshot card-signed
+1 press b
+1 release b
+1 press b
+1 release b
until app none
until idle
