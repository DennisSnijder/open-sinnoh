# Turnback Cave: enter the postgame Distortion World through the native portal.
set flag platinum:FLAG_HIDE_TURNBACK_CAVE_GIRATINA_ROOM_GIRATINA true
warp platinum:MAP_HEADER_TURNBACK_CAVE_GIRATINA_ROOM 11 15 up
until idle 6000
+0 press a
+1 release a
advance text 6000
+0 press a
+1 release a
advance text 6000
until idle 6000
+0 assert state player.zone "platinum:MAP_HEADER_DISTORTION_WORLD_TURNBACK_CAVE_ROOM"
+0 assert state player.y 1040

