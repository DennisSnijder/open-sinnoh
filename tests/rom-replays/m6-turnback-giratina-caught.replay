+0 assert state party[5].form 0
+0 press a
+1 release a
advance text 6000
+0 press a
+1 release a
advance text 6000
until idle 6000
+0 assert state player.zone "platinum:MAP_HEADER_DISTORTION_WORLD_TURNBACK_CAVE_ROOM"
+0 assert state party[5].form 1
+0 assert state player.y 1040

