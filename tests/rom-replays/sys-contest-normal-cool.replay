# A Normal Rank Cool Contest, offline (decomp scripts_contests.s, contest.c; docs/research/contests.md): the official
# receptionist, ENTER, NORMAL RANK, COOL CONTEST, the party in contest mode (ENTER on Staravia), the entry, the attire, the
# stage and its introductions, the contest app: the visual round (the host's messages, the dress-up by keys: Y to the
# Fashion Case's first White Fluff, A, Y to Staravia's head, A, X for DONE; then the judging's messages), the Dance
# Competition danced, the acting round played by touch, the results; the winner's ceremony and the prize. Staravia
# wins. It comes back with the Cool Ribbon, the photo in its White Fluff, the Red Barrette, the records and a little
# friendship; the save keeps them.
party 0 platinum:SPECIES_STARAVIA 20 platinum:MOVE_WING_ATTACK platinum:MOVE_TAKE_DOWN
set state party[0].condition {"cool":255,"beauty":255,"cute":0,"smart":0,"tough":255,"sheen":255}
set flag platinum:FLAG_CONTEST_HALL_VISITED true
set var platinum:VAR_CONTEST_HALL_LOBBY_STATE 1
set state fashionCase.accessories[0] 2
set state fashionCase.accessories[3] 1
set state fashionCase.accessories[30] 1
set state fashionCase.backdrops [4]
warp platinum:MAP_HEADER_CONTEST_HALL_LOBBY 16 5 up
until idle
+0 press a
+1 release a
# ENTER, NORMAL RANK, COOL CONTEST
advance text
until menu
+2 press a
+1 release a
advance text
until menu
+2 press a
+1 release a
advance text
until menu
+2 press a
+1 release a
advance text
until app party 600
+2 screenshot contest-entry
+2 tap slot:0
+2 tap menu:0
until app none 600
advance text 6000
until app contest 6000
+0 assert state player.zone "platinum:MAP_HEADER_CONTEST_HALL_STAGE_ONGOING_CONTEST"
+0 assert state contest.entrants[0].mon.species "platinum:SPECIES_STARAVIA"
+0 assert state contest.rank 0
+0 assert state contest.type 0
# The visual round: the host's six pages, then the stage fades in
until state app.round.message.waiting true 120
+2 screenshot contest-round
+0 press a
+1 release a
until state app.round.message.waiting true 60
+0 press a
+1 release a
until state app.round.message.waiting true 60
+0 press a
+1 release a
until state app.round.message.waiting true 60
+0 press a
+1 release a
until state app.round.message.waiting true 60
+0 press a
+1 release a
until state app.round.message.waiting true 60
+0 press a
+1 release a
until state app.round.dress.seconds 59 60
+1 press y
+1 release y
+1 press a
+1 release a
+1 press y
+1 release y
+1 press a
+1 release a
+1 assert state app.round.dress.placed 1
+1 screenshot contest-dress
+1 press x
+1 release x
# The judging: its ten pages (the start, two per entrant, the dance's announcement) between the photos and hearts
until state app.round.message.waiting true 300
+2 screenshot contest-judging
+0 press a
+1 release a
until state app.round.message.waiting true 300
+0 press a
+1 release a
until state app.round.message.waiting true 300
+0 press a
+1 release a
until state app.round.scoring.curtain false 120
+20 screenshot contest-hearts
until state app.round.message.waiting true 300
+0 press a
+1 release a
until state app.round.message.waiting true 300
+0 press a
+1 release a
until state app.round.message.waiting true 300
+0 press a
+1 release a
until state app.round.message.waiting true 300
+0 press a
+1 release a
until state app.round.message.waiting true 300
+0 press a
+1 release a
until state app.round.message.waiting true 300
+0 press a
+1 release a
until state app.round.message.waiting true 300
+0 press a
+1 release a
# The Dance Competition (song 0, 120 BPM: a beat is 15 ticks, a measure 240): the MC's three pages, then the song.
# Staravia leads the last round and dances three steps a measure on the beats; it copies no one, so its points are
# exactly the lead's 2 × 3 × 2 on every seed.
until state app.round.round "dance" 60
until state app.round.message.waiting true 60
+2 press a
+1 release a
+4 press a
+1 release a
+4 press a
+1 release a
+1964 press down
+1 release down
+29 press left
+1 release left
+29 press right
+1 release right
+179 press down
+1 release down
+29 press left
+1 release left
+29 press right
+1 release right
# The song ends; the MC names the leader (three pages)
until state app.round.message.waiting true 900
+2 press a
+1 release a
+4 press a
+1 release a
+4 press a
+1 release a
until state app.round.round "acting" 60
+0 assert state contest.scores.dance[0] 12
# The acting round: four turns, each a move (Wing Attack and Take Down in turn: last turn's move is off the menu)
# and the main judge, by touch
until state contest.acting {"turn":0,"choosing":true} 6000
+1 tap move:0
+8 tap judge:1
until state contest.acting {"turn":1,"choosing":true} 9000
+1 tap move:1
+8 tap judge:1
until state contest.acting {"turn":2,"choosing":true} 9000
+1 tap move:0
+8 tap judge:1
until state contest.acting {"turn":3,"choosing":true} 9000
+1 tap move:1
+8 tap judge:1
# The results (the table before the announcements), then the judging, the three rounds' columns and the winner
until state contest.placement 0 9000
+2 screenshot contest-results
+2 press a
+1 release a
+2 press a
+1 release a
+2 press a
+1 release a
+2 press a
+1 release a
+2 press a
+1 release a
+2 press a
+1 release a
+2 press a
+1 release a
+2 press a
+1 release a
+2 press a
+1 release a
+2 press a
+1 release a
+2 press a
+1 release a
+2 press a
+1 release a
until app none 600
advance text 9000
until idle 9000
+0 assert state player.zone "platinum:MAP_HEADER_CONTEST_HALL_LOBBY"
+0 assert state party[0].ribbons [33]
+0 assert state fashionCase.accessories[73] 1
+0 assert state contestPhotos[0].mon.species "platinum:SPECIES_STARAVIA"
+0 assert state contestPhotos[0].rank 0
+0 assert state contestPhotos[0].dressUp.accessories[0].accessory 0
+0 assert state contestPhotos[0].dressUp.backdrop 0
+0 assert state records.counts["90"] 1
+0 assert state records.counts["92"] 1
+0 assert state records.counts["94"] 1
+0 reload
until idle
+0 assert state party[0].ribbons [33]
+0 assert state contestPhotos[0].trainerName "Lucas"
