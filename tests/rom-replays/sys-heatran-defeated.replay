# sys-heatran-defeated (docs/research/postgame.md §3): Stark Mountain room 3, Heatran.
# The constructed start of sys-heatran-caught; Heatran knocked out (battle auto): check_won_battle, the Vs. Seeker
# level 5 unlock, check_did_not_capture TRUE: "Heatran disappeared", not caught, hidden until the Hall of Fame (state 2).
party 0 platinum:SPECIES_GARCHOMP 70 platinum:MOVE_DRAGON_CLAW platinum:MOVE_EARTHQUAKE
set flag platinum:FLAG_GAME_COMPLETED true
set state pokedex.national true
set flag platinum:FLAG_TALKED_TO_BATTLEGROUND_BUCK true
set var platinum:VAR_STARK_MOUNTAIN_ROOM_3_STATE 1
warp platinum:MAP_HEADER_STARK_MOUNTAIN_ROOM_3 7 7 up
until idle
+0 press a
+1 release a
advance text 3000
battle auto 20000
+0 assert battle scripted platinum:SPECIES_HEATRAN won
advance text 20000
until idle 3000
+0 assert flag platinum:FLAG_CAUGHT_HEATRAN false
+0 assert flag platinum:FLAG_BATTLED_STARK_MOUNTAIN_ROOM_3_HEATRAN true
+0 assert flag platinum:FLAG_UNLOCKED_VS_SEEKER_LVL_5 true
+0 assert flag platinum:FLAG_HIDE_STARK_MOUNTAIN_ROOM_3_HEATRAN true
+0 assert flag platinum:FLAG_MAP_LOCAL_REMOVE_OBJECT false
+0 assert var platinum:VAR_STARK_MOUNTAIN_ROOM_3_STATE 2
+0 assert state party.length 1
