from svc-egg.replay
# svc-hatch: the Pichu egg has no cycles left (set here; a cycle is 255
# steps) and the egg-cycle counter is 5 steps from the end of a cycle. Walking on, the cycle ends and the
# field runs CommonScript_HatchEgg: "Oh?", the hatching scene (the egg shakes and cracks, the Pichu, its
# cry and the fanfare), "Would you like to nickname …?" YES, the naming keyboard. The Pichu keeps the egg's
# PID and moves, has friendship 120, and is caught in the Pokédex.
set state party[2].friendship 0
set state daycare.stepCounter 250
+0 press left
until state daycare.stepCounter 0
+0 release left
+0 assert state party[2].isEgg true
# "Oh?" waits for A (WaitABPress) once printed
+30 press a
+1 release a
until app hatch
+0 assert state party[2].isEgg false
+0 assert state party[2].friendship 120
+0 assert state party[2].pid 2018915346
+0 assert state party[2].moves ["platinum:MOVE_THUNDER_SHOCK","platinum:MOVE_CHARM","platinum:MOVE_VOLT_TACKLE"]
+0 assert state pokedex.caught ["platinum:SPECIES_TURTWIG","platinum:SPECIES_PIKACHU","platinum:SPECIES_STARLY","platinum:SPECIES_PICHU"]
+40 screenshot hatch-shake
+180 screenshot hatch-mon
# The question comes after the cry and the fanfare (the scene's own timing; a tap before it is ignored)
+300 screenshot hatch-question
+0 tap yes
until app naming
+1 tap type:Sparky
+1 tap ok
until app none
advance text
until idle
+0 assert state party[2].nickname "Sparky"
+0 assert state party[2].met.level 0
+0 assert state party[2].met.zone "platinum:MAP_HEADER_SOLACEON_TOWN"
+1 reload
+0 assert state party[2].nickname "Sparky"
until idle
